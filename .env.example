# Rate limiter service
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Redis (required). Do not commit real credentials.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Active algorithm at startup (overridden by Redis once set)
# token_bucket | sliding_window_log | sliding_window_counter
RATE_LIMIT_ALGORITHM=token_bucket

# When Redis is unavailable: closed = reject (503), open = allow
RATE_LIMIT_FAIL_MODE=closed

# Protects administrative endpoints (algorithm switch, tenant updates, stress test)
ADMIN_API_KEY=change-me-in-production

# WebSocket sampling of per-request events (0-1). Stats are always aggregated.
WS_DECISION_SAMPLE_RATE=0.04
METRICS_FLUSH_MS=100

# Frontend (baked in at build time)
VITE_ADMIN_API_KEY=change-me-in-production
VITE_API_BASE=/api
